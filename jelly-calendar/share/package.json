{
  "name": "jelly-share",
  "private": true,
  "description": "Shared jellies: Firestore rules, the bundled Firebase SDK for the web app, and tests.",
  "type": "module",
  "scripts": {
    "bundle": "node build.mjs",
    "test:rules": "firebase emulators:exec --project demo-jelly --only firestore \"node --test test/rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --project demo-jelly --only firestore,auth \"node test/e2e.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "esbuild": "^0.28.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1",
    "playwright-core": "^1.63.0"
  }
}
