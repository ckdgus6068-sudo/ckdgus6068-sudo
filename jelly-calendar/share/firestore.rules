rules_version = '2';

// Shared jellies ("공유 젤리"), encrypted end to end.
//
// spaces/{spaceId}                         one shared calendar: its owner and its sealed name
// spaces/{spaceId}/members/{uid}           who is in it, each with a sealed name and colour
// spaces/{spaceId}/jellies/{jellyId}       the shared jellies; every content field is sealed
// spaces/{spaceId}/jellies/{id}/memos/{m}  memos on a jelly, sealed
// invites/{id}                             a short-lived invite; its id comes from the invite code
//
// Everyone signs in anonymously. Content is sealed on the members' devices with a key the server
// never sees (docs/share/crypto.js), so these rules decide who may read and write what, and how
// big a sealed value may be. Joining a calendar takes a live invite to that very calendar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function spacePath(spaceId) {
      return /databases/$(database)/documents/spaces/$(spaceId);
    }

    function memberPath(spaceId, uid) {
      return /databases/$(database)/documents/spaces/$(spaceId)/members/$(uid);
    }

    function invitePath(id) {
      return /databases/$(database)/documents/invites/$(id);
    }

    function isMember(spaceId) {
      return signedIn() && exists(memberPath(spaceId, request.auth.uid));
    }

    // Calendars made before encryption name their creator "createdBy".
    function isOwner(spaceId) {
      return signedIn()
        && get(spacePath(spaceId)).data.get('owner', get(spacePath(spaceId)).data.get('createdBy', '')) == request.auth.uid;
    }

    // A value sealed on a device: base64url of IV, ciphertext and tag, so never shorter than 38.
    function sealed(value, max) {
      return value is string && value.size() >= 38 && value.size() <= max;
    }

    match /spaces/{spaceId} {
      allow get: if isMember(spaceId);
      allow list: if false;

      // Created in one batch together with the owner's member doc.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['v', 'owner', 'createdAt', 'meta'])
        && request.resource.data.v == 2
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.createdAt == request.time
        && sealed(request.resource.data.meta, 2000)
        && existsAfter(memberPath(spaceId, request.auth.uid));

      // Members may rename it; only the owner may hand it to another member.
      allow update: if isMember(spaceId)
        && resource.data.get('v', 1) == 2
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meta', 'owner'])
        && sealed(request.resource.data.meta, 2000)
        && (request.resource.data.owner == resource.data.owner
            || (resource.data.owner == request.auth.uid
                && exists(memberPath(spaceId, request.resource.data.owner))));

      allow delete: if isOwner(spaceId);

      match /members/{uid} {
        allow read: if isMember(spaceId);

        // Only yourself: as the owner in the batch that creates the calendar, or with a live
        // invite to this calendar.
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['joinedAt', 'profile', 'invite'])
          && request.resource.data.joinedAt == request.time
          && sealed(request.resource.data.profile, 2000)
          && (
            (!exists(spacePath(spaceId))
              && getAfter(spacePath(spaceId)).data.owner == request.auth.uid)
            || (exists(spacePath(spaceId))
              && request.resource.data.get('invite', '').size() == 43
              && exists(invitePath(request.resource.data.invite))
              && get(invitePath(request.resource.data.invite)).data.spaceId == spaceId
              && get(invitePath(request.resource.data.invite)).data.expiresAt > request.time)
          );

        // Changing your own name or colour.
        allow update: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile'])
          && sealed(request.resource.data.profile, 2000);

        // Leaving, or being let go by the owner.
        allow delete: if signedIn() && (uid == request.auth.uid || isOwner(spaceId));
      }

      match /jellies/{jellyId} {
        function validJelly(d) {
          return d.keys().hasOnly(['title', 'date', 'start', 'duration', 'flavor', 'done', 'note',
                                   'pinned', 'byName', 'updatedByName', 'by', 'createdAt', 'updatedBy',
                                   'updatedAt', 'memoCount', 'lastMemoAt'])
            && d.keys().hasAll(['title', 'date', 'start', 'duration', 'flavor', 'done', 'note',
                                'by', 'createdAt', 'updatedBy', 'updatedAt', 'memoCount'])
            && sealed(d.title, 1000)
            && sealed(d.date, 200)
            && sealed(d.start, 200)
            && sealed(d.duration, 200)
            && sealed(d.flavor, 200)
            && sealed(d.done, 200)
            && sealed(d.note, 6000)
            && (!('pinned' in d) || sealed(d.pinned, 200))
            && (!('byName' in d) || sealed(d.byName, 500))
            && (!('updatedByName' in d) || sealed(d.updatedByName, 500))
            && d.by is string
            && d.updatedBy is string
            && d.memoCount is int && d.memoCount >= 0;
        }

        allow read: if isMember(spaceId);

        allow create: if isMember(spaceId)
          && validJelly(request.resource.data)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.memoCount == 0;

        // Any member may change a shared jelly, but not who put it there. A memo only moves the
        // memo counter, so it does not count as an edit of the jelly itself.
        allow update: if isMember(spaceId)
          && validJelly(request.resource.data)
          && request.resource.data.by == resource.data.by
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            (request.resource.data.updatedBy == request.auth.uid
              && request.resource.data.updatedAt == request.time)
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memoCount', 'lastMemoAt'])
          );

        allow delete: if isMember(spaceId);

        match /memos/{memoId} {
          allow read: if isMember(spaceId);
          allow create: if isMember(spaceId)
            && request.resource.data.keys().hasOnly(['text', 'byName', 'by', 'at'])
            && request.resource.data.by == request.auth.uid
            && request.resource.data.at == request.time
            && sealed(request.resource.data.text, 3000)
            && sealed(request.resource.data.byName, 500);
          // Your own memos may be removed by you; when a jelly is deleted, its memos go with it.
          allow delete: if isMember(spaceId)
            && (resource.data.by == request.auth.uid
                || !existsAfter(/databases/$(database)/documents/spaces/$(spaceId)/jellies/$(jellyId)));
        }
      }
    }

    match /invites/{inviteId} {
      // Whoever holds the code can work out the id; nobody may list invites.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && inviteId.size() == 43
        && request.resource.data.keys().hasOnly(['spaceId', 'by', 'expiresAt', 'wrapped'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.spaceId is string
        && isMember(request.resource.data.spaceId)
        && get(spacePath(request.resource.data.spaceId)).data.get('v', 1) == 2
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(4, 'd')
        && sealed(request.resource.data.wrapped, 1000);

      // The person who made it may withdraw it; anyone may clear it away once it has run out.
      allow delete: if signedIn()
        && (resource.data.by == request.auth.uid || resource.data.expiresAt < request.time);
    }
  }
}
